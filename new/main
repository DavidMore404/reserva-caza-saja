const ALIAS={
  'FRESNEDA Y GESIA':'FRESNEDA Y LA GESIA','COO SAN CIPRIANO':'COO-SAN CIPRIANO',
  'SAN CIFRIAB':'SAN CIFRIAN','SAN CIFRIÁBN':'SAN CIFRIAN','CAVIÑA':'CAVINA',
  'EL TÁLADRO':'EL TALADRO','MOZAGRUCO':'MOZAGRUCU','PÁMANES':'PAMANES',
  'ARGÜESO':'ARGUESO','NEGRÉU':'NEGREU','TEJÉU':'TEJEU','FONFRÍA':'FONFRICA',
  'MILEBAÑOS':'MILEBANOS','VALLEJAS DE SAN PABLO':'VALLEJAS',
  'GUSTÍO FONTECHA':'GUSTIO FONTECHA','PEÑA COLSA':'PENA COLSA',
  'PEÑA FRESNEDA':'PENA FRESNEDA','BÁRCENA VERDUJAL':'BARCENA VERDUJAL',
  'VALFRÍA':'VALFRIA','ROZALÉN':'ROZALEN','LA MIÑA':'LA MINA','PROAÑO':'PROANO',
  'MONTE Aá':'MONTE AA','MONTE AÁ':'MONTE AA',
};

function normalize(s){
  if(!s) return '';
  let n=s.toUpperCase().trim()
    .replace(/Á/g,'A').replace(/É/g,'E').replace(/Í/g,'I').replace(/Ó/g,'O').replace(/Ú/g,'U').replace(/Ñ/g,'N')
    .replace(/\s+/g,' ');
  return ALIAS[n]||n;
}
function getDates(name){const k=normalize(name);return CAL[k]||CAL[ALIAS[k]]||null;}

// ── Mapa ──────────────────────────────────────────────────────────────────
const TODAY=new Date();
const map=L.map('map').setView([43.12,-4.38],11);
L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png',{attribution:'© OpenStreetMap',maxZoom:19}).addTo(map);

const SC={active:'#E24B4A',upcoming:'#EF9F27',none:'#639922'};
const SB={active:'#FCEBEB',upcoming:'#FAEEDA',none:'#EAF3DE'};
const SL={active:'Cacería hoy',upcoming:'Cacería próxima (7d)',none:'Sin actividad próxima'};
const SE={J:'🐗 Jabalí',B:'🎯 Sorda/Laguneja',L:'🐇 Liebre'};

let layerMap={},activeLot=null,gpsWatcher=null,gpsMarker=null,lotsData=[],gpsActive=false;

function getStatus(dates){
  if(!dates) return 'none';
  const all=[].concat(...Object.values(dates));
  for(const d of all){if(Math.abs(new Date(d+'T12:00:00')-TODAY)<86400000) return 'active';}
  for(const d of all){const dt=new Date(d+'T12:00:00')-TODAY;if(dt>0&&dt<=7*86400000) return 'upcoming';}
  return 'none';
}
function fmtD(ds){return new Date(ds+'T12:00:00').toLocaleDateString('es-ES',{weekday:'short',day:'2-digit',month:'short'});}

function openPanel(lot){
  if(activeLot){const p=layerMap[activeLot.id];if(p)p.layer.setStyle({color:p.col,fillColor:p.col,fillOpacity:.3,weight:2,opacity:.85});}
  activeLot=lot;
  const{st,col,layer}=layerMap[lot.id]||{};
  if(layer) layer.setStyle({color:col,fillColor:col,fillOpacity:.5,weight:3,opacity:1});
  document.getElementById('pn').style.cssText=`background:${SB[st]||SB.none};color:${col||SC.none}`;
  document.getElementById('pn').textContent=lot.id;
  document.getElementById('pname').textContent=lot.name;
  document.getElementById('pinfo').textContent=(lot.area||'—')+(lot.comarca?' · '+lot.comarca:'');
  const dates=getDates(lot.name);
  let html=`<div class="stag" style="background:${SB[st]};color:${col}"><div class="sdot" style="background:${col}"></div>${SL[st]}</div>`;
  if(dates&&Object.keys(dates).length){
    Object.entries(dates).forEach(([sp,arr])=>{
      if(!arr||!arr.length) return;
      html+=`<div class="sec">${SE[sp]||sp}</div>`;
      arr.forEach(d=>{
        const dt=new Date(d+'T12:00:00')-TODAY;
        const isT=Math.abs(dt)<86400000,isU=dt>0&&dt<=7*86400000;
        const dot=isT?'#E24B4A':isU?'#EF9F27':'#ddd',tc=isT||isU?'#222':'#aaa';
        html+=`<div class="di"><div class="sdot" style="background:${dot}"></div><span style="color:${tc}">${fmtD(d)}${isT?' 🔴 HOY':isU?' 🟠 próx.':''}</span></div>`;
      });
    });
  } else {
    html+=`<div style="color:#bbb;font-size:11px;margin-top:8px">Sin datos de cacería para este lote.</div>`;
  }
  const tot=dates?Object.values(dates).reduce((a,b)=>a+b.length,0):0;
  document.getElementById('pb').innerHTML=html;
  document.getElementById('psb').textContent=tot?`${tot} jornadas esta temporada`:'Datos pendientes';
  document.getElementById('panel').classList.add('open');
  setTimeout(()=>map.invalidateSize(),250);
}
function closePanel(){
  if(activeLot){const p=layerMap[activeLot.id];if(p)p.layer.setStyle({color:p.col,fillColor:p.col,fillOpacity:.3,weight:2,opacity:.85});activeLot=null;}
  document.getElementById('panel').classList.remove('open');
  setTimeout(()=>map.invalidateSize(),250);
}

// ── Reproyección ──────────────────────────────────────────────────────────
function detectCRS(gj){
  const c=gj.crs?.properties?.name||'';
  if(c.includes('25830')||c.includes('32630')) return 'EPSG:25830';
  try{const f=gj.features?.[0]?.geometry?.coordinates.flat(10);if(Math.abs(f[0])>180)return 'EPSG:25830';}catch(e){}
  return null;
}
function reproject(gj,epsg){
  function rC(c){if(typeof c[0]==='number'){const[lo,la]=proj4(epsg,'WGS84',[c[0],c[1]]);return[lo,la];}return c.map(rC);}
  const out=JSON.parse(JSON.stringify(gj));
  out.features.forEach(f=>{if(f.geometry?.coordinates)f.geometry.coordinates=rC(f.geometry.coordinates);});
  return out;
}

function initMap(gj){
  Object.values(layerMap).forEach(v=>{try{map.removeLayer(v.layer);if(v.mk)map.removeLayer(v.mk);}catch(e){}});
  layerMap={};lotsData=[];activeLot=null;let idx=0;
  gj.features.forEach(f=>{
    const p=f.properties||{};
    const num=p.NUMERO||p.numero||p.NUM||idx+1;
    const name=p.DENOMINACI||p.NOMBRE||p.nombre||p.NAME||p.name||('Lote '+num);
    const ha=p.HECTARES||p.hectares?(((p.HECTARES||p.hectares)||0)|0)+' ha':'—';
    const comarca=p.COMARCA||p.comarca||'';
    const dates=getDates(name);
    const st=getStatus(dates),col=SC[st];
    const lot={id:num,name,area:ha,comarca,dates,st,col};
    lotsData.push(lot);
    const layer=L.geoJSON(f,{style:{color:col,fillColor:col,fillOpacity:.3,weight:2,opacity:.85}}).addTo(map);
    const ctr=layer.getBounds().getCenter();
    const mk=L.marker(ctr,{icon:L.divIcon({
      html:`<div style="width:20px;height:20px;background:${col};border-radius:50%;border:2.5px solid rgba(255,255,255,.9);display:flex;align-items:center;justify-content:center;font-size:9px;font-weight:700;color:#fff;cursor:pointer;box-shadow:0 1px 3px rgba(0,0,0,.2)">${num}</div>`,
      className:'',iconSize:[20,20],iconAnchor:[10,10]
    })}).addTo(map);
    layerMap[num]={layer,mk,lot,st,col};
    layer.on('click',()=>openPanel(lot));mk.on('click',()=>openPanel(lot));idx++;
  });
  map.fitBounds(L.geoJSON(gj).getBounds().pad(.04));
  document.getElementById('leg').style.display='';
  document.getElementById('ctrl').style.display='flex';
  setTimeout(()=>map.invalidateSize(),100);
}

function processGeoJSON(text,save=true){
  const st=document.getElementById('st');
  try{
    let gj=JSON.parse(text);
    if(!gj.features?.length) throw new Error('Sin entidades');
    const epsg=detectCRS(gj);
    if(epsg) gj=reproject(gj,epsg);
    if(save){try{localStorage.setItem(STORAGE_KEY,text);}catch(e){}}
    document.getElementById('loader').style.display='none';
    initMap(gj);
  }catch(e){st.className='err';st.textContent='Error: '+e.message;}
}

// ── Carga inicial ─────────────────────────────────────────────────────────
(async()=>{
  const st=document.getElementById('st');
  // 1. Intentar desde GitHub
  try{
    st.textContent='Descargando cartografía…';
    const res=await fetch(GEOJSON_URL);
    if(res.ok){const text=await res.text();processGeoJSON(text,true);return;}
  }catch(e){}
  // 2. Intentar desde localStorage (sin conexión)
  try{
    const saved=localStorage.getItem(STORAGE_KEY);
    if(saved){st.textContent='Sin conexión — cargando mapa guardado…';processGeoJSON(saved,false);return;}
  }catch(e){}
  // 3. Pedir archivo manualmente
  st.textContent='No se pudo descargar la cartografía. Cárgala manualmente.';
  document.getElementById('dz').style.display='block';
})();

// ── Subida manual ─────────────────────────────────────────────────────────
document.getElementById('fi').addEventListener('change',e=>{
  const f=e.target.files[0];if(!f)return;
  const r=new FileReader();r.onload=ev=>processGeoJSON(ev.target.result,true);r.readAsText(f);
});
const dz=document.getElementById('dz');
dz.addEventListener('dragover',e=>{e.preventDefault();dz.classList.add('drag');});
dz.addEventListener('dragleave',()=>dz.classList.remove('drag'));
dz.addEventListener('drop',e=>{
  e.preventDefault();dz.classList.remove('drag');
  const f=e.dataTransfer.files[0];if(!f)return;
  const r=new FileReader();r.onload=ev=>processGeoJSON(ev.target.result,true);r.readAsText(f);
});
function clearAndReload(){
  if(!confirm('¿Borrar cartografía guardada?'))return;
  try{localStorage.removeItem(STORAGE_KEY);}catch(e){}
  location.reload();
}

// ── GPS ───────────────────────────────────────────────────────────────────
function toggleGPS(){if(gpsActive)stopGPS();else startGPS();}
function startGPS(){
  if(!navigator.geolocation){alert('GPS no disponible');return;}
  const btn=document.getElementById('gbtn');
  btn.textContent='⌛ Localizando…';
  gpsWatcher=navigator.geolocation.watchPosition(pos=>{
    gpsActive=true;
    btn.textContent='📍 GPS activo';btn.style.background='#e8f5e9';
    document.getElementById('gpsbadge').style.display='block';
    const ll=[pos.coords.latitude,pos.coords.longitude];
    if(gpsMarker)map.removeLayer(gpsMarker);
    gpsMarker=L.layerGroup([
      L.circle(ll,{radius:pos.coords.accuracy/2,color:'#185FA5',fillColor:'#378ADD',fillOpacity:.12,weight:1}),
      L.circleMarker(ll,{radius:8,color:'#fff',fillColor:'#378ADD',fillOpacity:1,weight:2.5})
    ]).addTo(map);
    if(pos.coords.accuracy<500)map.setView(ll,Math.max(map.getZoom(),14));
    const inLot=lotsData.find(lot=>{const lm=layerMap[lot.id];return lm&&lm.layer.getBounds().contains(ll);});
    if(inLot&&(!activeLot||activeLot.id!==inLot.id))openPanel(inLot);
  },err=>{
    const msg={1:'Permiso denegado.',2:'GPS no disponible.',3:'Tiempo agotado.'};
    alert(msg[err.code]||'Error GPS');stopGPS();
  },{enableHighAccuracy:true,timeout:15000,maximumAge:5000});
}
function stopGPS(){
  if(gpsWatcher!=null){navigator.geolocation.clearWatch(gpsWatcher);gpsWatcher=null;}
  gpsActive=false;
  const btn=document.getElementById('gbtn');
  if(btn){btn.textContent='📍 Activar GPS';btn.style.background='';}
  document.getElementById('gpsbadge').style.display='none';
  if(gpsMarker){map.removeLayer(gpsMarker);gpsMarker=null;}
}
</script>
